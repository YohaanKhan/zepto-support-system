# ── Sprint 1: REQUIRED NOW ─────────────────────────────
# supabase-js only — no DATABASE_URL / connection string needed.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # new naming for anon
SUPABASE_SECRET_KEY=sb_secret_...                          # new naming for service_role — server-only, ingest uses this. NEVER prefix NEXT_PUBLIC_.

# ── Sprint 8: LLM replies (default Groq free tier, no card) ─
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_MS=5000

# ── Sprint 13: Qdrant hybrid retrieval (bonus) ─────────
RETRIEVER=tfidf            # tfidf | hybrid
QDRANT_URL=
QDRANT_API_KEY=

# ── Sprint 11: approve/override write-back (bonus) ─────
ENABLE_WRITE_BACK=false    # keep false during judging — mutating precedents mid-demo breaks the 11/19 table
